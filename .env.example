# ID del formulario de Formspree (la parte final de https://formspree.io/f/<id>).
# Sin este valor, el formulario de contacto muestra el estado de error.
NEXT_PUBLIC_FORMSPREE_ID=

# URL pública del sitio, sin barra final (por ejemplo https://mi-dominio.com). La usan las etiquetas
# Open Graph y Twitter. Si falta, en Vercel se usa el dominio de producción del proyecto y, fuera de
# Vercel, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
